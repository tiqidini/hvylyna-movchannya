  <button id="cookie-ok-btn">OK</button>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var notice = document.getElementById('cookie-notice');
  var okBtn = document.getElementById('cookie-ok-btn');
  if (!localStorage.getItem('cookieAccepted')) {
    notice.style.display = 'block';
  }
  okBtn.onclick = function() {
    localStorage.setItem('cookieAccepted', '1');
    notice.style.display = 'none';
  };
});
</script>  
    <script defer src="/templates/moby/js/fix-video-ads.js"></script>
    <script defer src="/templates/moby/js/tb-waveform.js?v=8.2"></script>
    
    <style>
#rsyaRightWrap{
  position:fixed !important;
  right:16px !important;
  bottom:16px !important;
  width:360px !important;
  min-height:180px !important;
  max-width:calc(100vw - 32px) !important;
  z-index:2147483000 !important;

  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transition:opacity .25s ease;
}

#rsyaRightWrap.rsya-ready{
  opacity:1;
  visibility:visible;
  pointer-events:auto;
}

#rsyaRightSlot{
  width:100% !important;
  min-height:180px !important;
  overflow:visible !important;
}

#rsyaRightClose{
  position:absolute !important;
  top:-40px !important;
  right: 0px !important;
  width:32px !important;
  height:32px !important;
  border:1px solid #cfcfcf !important;
  border-radius:8px !important;
  background:#fff !important;
  color:#111 !important;
  font-size:22px !important;
  line-height:28px !important;
  text-align:center !important;
  cursor:pointer !important;
  z-index:2147483001 !important;
  box-shadow:0 2px 10px rgba(0,0,0,.18) !important;
  padding:0 !important;
  display:none !important;
}

#rsyaRightWrap.rsya-ready #rsyaRightClose{
  display:block !important;
}

@media (max-width: 1400px){
  #rsyaRightWrap{
    display:none !important;
  }
}
</style>

<div id="rsyaRightWrap" aria-label="Реклама">
  <button id="rsyaRightClose" type="button" aria-label="Закрыть рекламу">×</button>
  <div id="rsyaRightSlot">
    <div id="yandex_rtb_R-A-3663129-103"></div>
  </div>
</div>

<script>
(function () {
  const wrap = document.getElementById('rsyaRightWrap');
  const closeBtn = document.getElementById('rsyaRightClose');

  if (!wrap || !closeBtn) return;

  // если уже закрывали в этой сессии
  if (sessionStorage.getItem('rsya_right_closed') === '1') {
    wrap.remove();
    return;
  }

  closeBtn.addEventListener('click', function () {
    sessionStorage.setItem('rsya_right_closed', '1');
    wrap.remove();
  });

  // не на узких экранах
  if (window.innerWidth < 1400) {
    wrap.remove();
    return;
  }

  let requested = false;

  function renderRightAd() {
    if (requested) return;
    requested = true;

    window.yaContextCb = window.yaContextCb || [];
    window.yaContextCb.push(function () {
      Ya.Context.AdvManager.render(
        {
          blockId: "R-A-3663129-103",
          renderTo: "yandex_rtb_R-A-3663129-103",
          onRender: function () {
            wrap.classList.add('rsya-ready');
          },
          onError: function (data) {
            console.log('RSYA error', data);
            wrap.remove();
          }
        },
        function () {
          // если рекламы нет
          wrap.remove();
        }
      );
    });
  }

  function onScrollLoad() {
    if (window.scrollY >= 400) {
      window.removeEventListener('scroll', onScrollLoad);
      renderRightAd();
    }
  }

  window.addEventListener('scroll', onScrollLoad, { passive: true });
  onScrollLoad();
})();
</script>

</body>
</html>